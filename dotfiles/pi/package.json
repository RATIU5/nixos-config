{
  "name": ".pi",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "agent/extensions/*"
  ],
  "scripts": {
    "check": "bun run --filter pi-save-md-extension check && bun run --filter pi-web-tools-extension check && bun run --filter pi-skill-toggle typecheck",
    "test:save-md": "bun run --filter pi-save-md-extension test",
    "test:web-tools": "bun run --filter pi-web-tools-extension test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@earendil-works/pi-tui": "^0.80.3",
    "typebox": "^1.1.38"
  }
}
