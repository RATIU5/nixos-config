// bobrwm config — place at ~/.config/bobrwm/config.zon
// or pass via: bobrwm -c /path/to/config.zon
.{
.start_at_login = true,

    // Layout algorithm.
    // .layout = .bsp,
    // Or fullscreen-per-window tiling:
    // .layout = .monocle,

    // BSP split axis policy.
    // .auto picks axis from target tile geometry (yabai-style).
    // .horizontal always splits left/right, .vertical always splits top/bottom.
    // .bsp_split = .auto,

    // BSP insertion target policy.
    // .split creates a new split, .stack adds to target leaf stack.
    // .bsp_insert_mode = .split,
    //
    // BSP insertion point policy.
    // .focused, .first, .last, .min_depth
    // .bsp_insert_point = .focused,

    // Default ratio for newly-created BSP splits (clamped to 0.1..0.9).
    // .bsp_split_ratio = 0.5,

    // Placement for newly tiled windows when splitting.
    // .second = right/bottom, .first = left/top
    // .new_window_split = .second,

    // Gaps between windows (pixels). Omit or set to 0 for no gaps.
    // .gaps = .{
    //     .inner = 4,
    //     .outer = .{ .left = 4, .right = 4, .top = 4, .bottom = 4 },
    // },

    .keybinds = .{
        // Bobrwm merges config keybinds with built-in defaults (Option-based).
        // Reassign each default Option trigger to center_float — a no-op on tiled
        // windows — so workspace/navigation is Control-only below.
        .{ .key = "1", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "2", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "3", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "4", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "5", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "6", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "7", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "8", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "9", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "1", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "2", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "3", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "4", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "5", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "6", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "7", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "8", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "9", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "h", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "j", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "k", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "l", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "return", .mods = .{ .alt = true }, .action = .center_float },
        .{ .key = "h", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "j", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "k", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "l", .mods = .{ .alt = true, .shift = true }, .action = .center_float },
        .{ .key = "r", .mods = .{ .alt = true, .shift = true }, .action = .center_float },

        // ctrl+1..9 → focus workspace (macOS ^1..^9 desktop shortcuts disabled in
        // hosts/darwin/default.nix so bobrwm receives these keys).
        .{ .key = "1", .mods = .{ .ctrl = true }, .action = .focus_workspace, .arg = 1 },
        .{ .key = "2", .mods = .{ .ctrl = true }, .action = .focus_workspace, .arg = 2 },
        .{ .key = "3", .mods = .{ .ctrl = true }, .action = .focus_workspace, .arg = 3 },
        .{ .key = "4", .mods = .{ .ctrl = true }, .action = .focus_workspace, .arg = 4 },
        .{ .key = "5", .mods = .{ .ctrl = true }, .action = .focus_workspace, .arg = 5 },
        .{ .key = "6", .mods = .{ .ctrl = true }, .action = .focus_workspace, .arg = 6 },
        .{ .key = "7", .mods = .{ .ctrl = true }, .action = .focus_workspace, .arg = 7 },
        .{ .key = "8", .mods = .{ .ctrl = true }, .action = .focus_workspace, .arg = 8 },
        .{ .key = "9", .mods = .{ .ctrl = true }, .action = .focus_workspace, .arg = 9 },

        // ctrl+shift+1..9 → move window to workspace
        .{ .key = "1", .mods = .{ .ctrl = true, .shift = true }, .action = .move_to_workspace, .arg = 1 },
        .{ .key = "2", .mods = .{ .ctrl = true, .shift = true }, .action = .move_to_workspace, .arg = 2 },
        .{ .key = "3", .mods = .{ .ctrl = true, .shift = true }, .action = .move_to_workspace, .arg = 3 },
        .{ .key = "4", .mods = .{ .ctrl = true, .shift = true }, .action = .move_to_workspace, .arg = 4 },
        .{ .key = "5", .mods = .{ .ctrl = true, .shift = true }, .action = .move_to_workspace, .arg = 5 },
        .{ .key = "6", .mods = .{ .ctrl = true, .shift = true }, .action = .move_to_workspace, .arg = 6 },
        .{ .key = "7", .mods = .{ .ctrl = true, .shift = true }, .action = .move_to_workspace, .arg = 7 },
        .{ .key = "8", .mods = .{ .ctrl = true, .shift = true }, .action = .move_to_workspace, .arg = 8 },
        .{ .key = "9", .mods = .{ .ctrl = true, .shift = true }, .action = .move_to_workspace, .arg = 9 },

        // ctrl+hjkl → focus direction
        .{ .key = "h", .mods = .{ .ctrl = true }, .action = .focus_left },
        .{ .key = "j", .mods = .{ .ctrl = true }, .action = .focus_down },
        .{ .key = "k", .mods = .{ .ctrl = true }, .action = .focus_up },
        .{ .key = "l", .mods = .{ .ctrl = true }, .action = .focus_right },

        // ctrl+return → toggle split direction
        .{ .key = "return", .mods = .{ .ctrl = true }, .action = .toggle_split },

        // ctrl+f → toggle floating window
        .{ .key = "f", .mods = .{ .ctrl = true }, .action = .toggle_float },

        // ctrl+shift+r → reload config (replaces default Option+Shift+R)
        .{ .key = "r", .mods = .{ .ctrl = true, .shift = true }, .action = .reload_config },
    },

    .workspace_assignments = .{
        // .{ .app_id = "com.apple.Safari", .workspace = 2 },
        // .{ .app_id = "com.apple.MobileSMS", .workspace = 3 },
    },
}
